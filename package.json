{
  "name": "team-razka-program",
  "productName": "TEAM RAZKA PROGRAM",
  "description": "BeamNG mod library for Team Razka members.",
  "author": "Team Razka",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package:win": "pnpm build && electron-builder --win nsis portable",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "\"dist/setup/Discord Setup.exe\"",
    "bot:register": "tsx scripts/register-bot.ts",
    "bot": "tsx server/bot.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@fastify/rate-limit": "11.2.2",
    "discord.js": "14.28.1",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "json5": "2.2.3",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.162.0",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "com.teamrazka.program",
    "productName": "TEAM RAZKA PROGRAM",
    "beforeBuild": "scripts/before-build.cjs",
    "directories": {
      "output": "release",
      "app": "dist/package"
    },
    "files": [
      "dist/desktop/**",
      "dist/renderer/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Team Razka Program ${version} ${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Team Razka Program Setup.exe"
    },
    "portable": {
      "artifactName": "Team Razka Program.exe"
    }
  }
}
